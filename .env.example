# Copy to .env and fill in. Docker Compose reads this file automatically.

# The exact URL people open in their browser, with no trailing slash.
# Passkeys need a host name (such as localhost or relay.example.com), not an IP address.
RELAY_ORIGIN=http://localhost:3090

# Password for the first account, "admin". Only used while the database has no accounts.
RELAY_ADMIN_PASSWORD=

# Key for share-link and request tokens, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Keep it with your backups: restoring with a different key keeps every file but breaks existing links.
RELAY_SECRET=

# Automatic recovery snapshots.
RELAY_BACKUP_INTERVAL_HOURS=24
RELAY_BACKUP_KEEP=7
