# Optional. Copy to .env to change anything; Docker Compose reads it automatically.
# Local setup works without environment settings.

# The exact address people open, such as https://relay.example.com, with no trailing slash.
# Required for a public hostname. Unset, only localhost and literal IP addresses are accepted.
# Set an HTTPS origin before public use; other hostnames and origins will be refused.
# Passkeys need a host name (such as localhost or relay.example.com), not an IP address.
RELAY_ORIGIN=

# Key for share-link and request tokens, at least 32 characters. Unset, Relay generates one and
# keeps it with the data. To choose your own, generate one with:
#   openssl rand -base64 48
# Moving the data to a different key keeps every file but breaks existing links.
RELAY_SECRET=

# Set to true to make first setup ask for a one-time key that only someone with access to the
# server can read, from <data>/setup.key (docker compose exec relay cat /data/setup.key). Useful
# when the setup page is reachable by others before you finish it. Off by default.
RELAY_SETUP_KEY=

# Private Compose backend network and the gateway's stable address on it.
# Choose a subnet that does not overlap with networks already used on this host.
RELAY_BACKEND_SUBNET=172.31.247.0/29
RELAY_GATEWAY_IP=172.31.247.2
RELAY_APP_IP=172.31.247.3

# Optional space-separated addresses/CIDRs for upstream proxies in front of
# Caddy that sanitize X-Forwarded-For. The default trusts loopback only.
# A host proxy through Docker may appear as the bridge gateway; verify its exact
# address and include that trusted hop here (see docs/self-hosting.md).
RELAY_CADDY_TRUSTED_PROXIES=127.0.0.1 ::1

# Only the actual reverse proxies may supply client IP addresses. Never trust arbitrary clients
# or broad private ranges shared with untrusted containers. With no trusted proxy configured,
# proxied visitors share a rate-limit bucket. The Compose gateway is trusted automatically;
# add only other trusted Relay proxies here. See docs/self-hosting.md for multi-proxy setups.
RELAY_TRUST_PROXY=127.0.0.1,::1

# Optional compose.tunnel.yaml only: existing network shared with a trusted tunnel/proxy.
RELAY_TUNNEL_NETWORK=streaming_lab_private
