{
  "id": "/",
  "name": "Relay",
  "short_name": "Relay",
  "description": "Send files, photos and text to your devices and the people you trust.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f6f4",
  "theme_color": "#f6f6f4",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  },
  "shortcuts": [
    { "name": "Files", "url": "/files", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Links", "url": "/links", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
