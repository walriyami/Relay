{
	auto_https off

	servers {
		# Space-separated addresses/CIDRs of upstream proxies that sanitize
		# forwarded headers. Strict mode walks X-Forwarded-For right to left.
		trusted_proxies static {$RELAY_CADDY_TRUSTED_PROXIES:127.0.0.1 ::1}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:3090 {
	# Compress app documents and bundles. API streams and byte-range downloads
	# keep their original wire representation; Relay compresses its own large
	# metadata responses, only for its own pages' requests (see server/lib/compress.ts).
	@app {
		not path /api/* /uploads/*
	}
	encode @app zstd gzip
	reverse_proxy relay-app:3090 {
		# Forward only Caddy's verified client address, never the raw chain.
		header_up X-Forwarded-For {client_ip}
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
