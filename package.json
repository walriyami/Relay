{
  "name": "relay",
  "version": "1.0.0",
  "description": "Private, self-hosted file, folder and text transfers for a trusted group.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web 'node --watch server/main.ts' 'vite --host 127.0.0.1'",
    "start": "node server/main.ts",
    "build": "npm run typecheck && NODE_ENV=production vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "screenshots": "node scripts/screenshots.ts",
    "verify:scale": "node scripts/verify-scale.ts",
    "verify:browser-scale": "node scripts/verify-browser-scale.ts",
    "verify:container": "node scripts/verify-container.ts",
    "verify:compose": "node scripts/verify-compose.ts",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "redeploy": "scripts/redeploy.sh",
    "test:resources": "playwright test --config tests/resources/playwright.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "fastify": "^5.6.0",
    "heic-decode": "^2.1.0",
    "lucide-react": "^0.468.0",
    "node-datachannel": "^0.33.4",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "tus-js-client": "^4.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "node": "^24.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.5"
  }
}
