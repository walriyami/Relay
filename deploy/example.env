# Copy this file to .env in the same folder and change the address. No passwords or tokens go here:
# the tunnel token goes in secrets/tunnel_token (README.md).

# The exact web address people will open, starting with https:// and with nothing after the name.
# It must match the public hostname you give the tunnel in Cloudflare. Changing it later breaks every
# link and passkey already handed out, so pick it once.
RELAY_ORIGIN=https://relay.example.com

# Leave empty. Only when an administrator is locked out: put their username here, run ./up.sh, read the
# one-time link in the log, then empty it again (README.md, "Locked out").
RELAY_RECOVER_ADMIN=
