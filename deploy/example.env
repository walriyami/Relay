# Copy this file to .env in the same folder. No passwords or keys go here: the tunnel's key is kept in
# secrets/ by tunnel-setup.sh (README.md).

# The exact web address people will open, starting with https:// and with nothing after the name.
# tunnel-setup.sh points this name at the tunnel. Changing it later breaks every link and passkey
# already handed out, so pick it once.
RELAY_ORIGIN=https://buildhatch.dev

# Filled in by tunnel-setup.sh: which Cloudflare Tunnel this machine runs.
TUNNEL_ID=

# Leave empty. Only when an administrator is locked out: put their username here, run ./up.sh, read the
# one-time link in the log, then empty it again (README.md, "Locked out").
RELAY_RECOVER_ADMIN=
